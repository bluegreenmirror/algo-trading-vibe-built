#.env.example
# Environment configuration (do NOT commit your .env)
ENV=dev

# Alpaca Paper API (obtain from Alpaca dashboard) — KEEP EMPTY in repo
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Symbols & schedule
SYMBOLS=AAPL,MSFT,SPY
SCHEDULE_CRON=*/5 * * * *
