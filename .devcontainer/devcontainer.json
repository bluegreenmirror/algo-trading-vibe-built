{
    "name": "Algo Bot (Python 3.13-slim)",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "editorconfig.editorconfig"
            ]
        }
    },
    "postCreateCommand": "python -V && python -m pip --version"
}