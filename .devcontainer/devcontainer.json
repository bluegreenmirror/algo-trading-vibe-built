{
  "name": "algo-bot-dev",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "app",
  "workspaceFolder": "/app",
  // This is critical. It tells VS Code not to inject its own startup command.
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": [
          "src"
        ],
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'if [ -f pyproject.toml ]; then poetry install; else echo \"[devcontainer] pyproject.toml not found at /app; skipping poetry install\"; fi'",
  "remoteUser": "root"
}