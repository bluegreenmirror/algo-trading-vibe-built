# Algo Trading Bot MVP - Environment Configuration
# Copy this file to .env and fill in your values

# Environment
ENV=dev

# Alpaca API Configuration
ALPACA_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Configuration
SYMBOLS=AAPL,MSFT,SPY
SCHEDULE_CRON=*/5 * * * *

# Risk Limits
MAX_POSITION_PER_SYMBOL=10000
MAX_GROSS_NOTIONAL=50000
DAILY_MAX_DRAWDOWN=1000
REQUIRE_HUMAN_APPROVAL_OVER=2500

# Strategy Parameters
STRAT_SMA_FAST=20
STRAT_SML_SLOW=50
MIN_VOLUME=100000

# Database
DATABASE_URL=sqlite:///./state.db
