# .gitignore
# This file is used to ignore files and directories in the repository.
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
dist/
build/
.DS_Store
.env
.venv
poetry.lock
secrets/
!secrets/.gitkeep
.gitleaks.*

.editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4